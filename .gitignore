.env

# OpenTofu/Terraform state and local plugin cache
**/.terraform/*
*.tfstate
*.tfstate.*
# Planos salvos (tofu plan -out) podem conter valores sensíveis
*.tfplan

# Vagrant box binaries and extracted contents
*.box
**/boxes/extracted/

# Inventário da AWS: gerado a cada VM (scripts/gerar-inventario-aws.sh)
infra/ansible/inventory/aws/hosts.ini
